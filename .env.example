# Global Environment Configuration Template
NODE_ENV=development
LOG_LEVEL=info

# Service Ports
PORT_GATEWAY=4000
PORT_IDENTITY=4001
PORT_MEMORY=4002
PORT_MEDIA=4003
PORT_COLLABORATION=4004
PORT_BOOK=4005
PORT_COMMERCE=4007
PORT_NOTIFICATION=4008

# Databases (PostgreSQL)
IDENTITY_DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/identity_db
MEMORY_DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/memory_db
MEDIA_DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/media_db
COLLAB_DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/collab_db
BOOK_DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/book_db
COMMERCE_DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/commerce_db
NOTIFICATION_DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/notification_db

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# NATS JetStream
NATS_URL=nats://localhost:4222

# S3 / Cloudflare R2 Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=memory-capsule-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
S3_FORCE_PATH_STYLE=true

# Security & Authentication
JWT_SECRET=dev-jwt-insecure-secret-change-in-production-min32chars
SESSION_SECRET=dev-session-insecure-secret-change-in-production-min32chars
