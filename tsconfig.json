{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@memory-capsule/contracts": ["./packages/contracts/src/index.ts"],
      "@memory-capsule/logger": ["./packages/logger/src/index.ts"],
      "@memory-capsule/events": ["./packages/events/src/index.ts"],
      "@memory-capsule/jobs": ["./packages/jobs/src/index.ts"],
      "@memory-capsule/storage": ["./packages/storage/src/index.ts"],
      "@memory-capsule/database": ["./packages/database/src/index.ts"],
      "@memory-capsule/proto": ["./packages/proto/src/index.ts"]
    }
  },
  "include": ["packages/**/*", "services/**/*", "tests/**/*"]
}
