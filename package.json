{
  "name": "memory-capsule",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @memory-capsule/web dev",
    "build:web": "pnpm --filter @memory-capsule/web build",
    "build": "pnpm -r build",
    "check:quality": "node --import tsx scripts/check-code-quality.ts",
    "test": "node --import tsx --test tests/*.ts",
    "lint": "pnpm run check:quality"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.11",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3",
    "sharp": "^0.33.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1"
  }
}
