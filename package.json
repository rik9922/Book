{
  "name": "memory-capsule",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:doctor": "node --import tsx scripts/ports/doctor.ts",
    "dev:ports": "node --import tsx scripts/ports/print-ports.ts",
    "dev:ports:check": "node --import tsx scripts/ports/check-ports.ts",
    "dev:up": "node --env-file=.env --import tsx scripts/ports/dev-orchestrator.ts up",
    "dev:down": "node --env-file=.env --import tsx scripts/ports/dev-orchestrator.ts down",
    "dev:restart": "node --env-file=.env --import tsx scripts/ports/dev-orchestrator.ts restart",
    "dev:status": "node --env-file=.env --import tsx scripts/ports/dev-orchestrator.ts status",
    "dev:logs": "node --env-file=.env --import tsx scripts/ports/dev-orchestrator.ts logs",
    "dev:web": "pnpm --filter @memory-capsule/web dev",
    "build:web": "pnpm --filter @memory-capsule/web build",
    "build": "pnpm -r build",
    "check:quality": "node --import tsx scripts/check-code-quality.ts",
    "test": "NODE_ENV=test node --env-file=.env --import tsx --test --test-concurrency=1 tests/*.ts",
    "lint": "pnpm run check:quality",
    "test:fixtures:generate": "node --import tsx testing/scripts/generate-test-data.ts",
    "test:fixtures:validate": "node --import tsx testing/scripts/validate-test-data.ts",
    "test:ios:inject": "node --import tsx testing/scripts/inject-simulator-media.ts",
    "test:ios:e2e": "node --env-file=.env --import tsx testing/scripts/run-ios-e2e-tests.ts",
    "test:ios:reset": "node --env-file=.env --import tsx testing/scripts/reset-test-data.ts",
    "test:ios:swift": "cd apps/ios/Memoria && swift test",
    "ios:generate": "cd apps/ios && xcodegen generate",
    "ios:build": "xcodebuild -project apps/ios/Memoria.xcodeproj -scheme Memoria -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "ios:test": "xcodebuild -project apps/ios/Memoria.xcodeproj -scheme MemoriaTests -destination 'platform=iOS Simulator,name=iPhone 17 Pro' CODE_SIGNING_ALLOWED=NO test",
    "ios:open": "open apps/ios/Memoria.xcodeproj",
    "ios:sim": "open -a Simulator",
    "backup:create": "node --env-file=.env --import tsx scripts/backup.ts",
    "backup:verify": "node --env-file=.env --import tsx scripts/restore.ts --verify-only",
    "backup:restore": "node --env-file=.env --import tsx scripts/restore.ts",
    "setup:pgadmin": "node --import tsx scripts/setup-pgadmin.ts"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.11",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3",
    "playwright-core": "^1.64.1",
    "sharp": "^0.33.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1"
  }
}
